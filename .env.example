DATABASE_URL=postgresql+asyncpg://app_user:app_password@localhost:5432/ai_agent
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=ai_agent
POSTGRES_PORT=5432

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
RABBITMQ_QUEUE=agent.runs
WORKER_PREFETCH=1
WORKER_CONCURRENCY=1
LEASE_TTL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=10
DECISION_TIMEOUT_SECONDS=10
DECISION_MAX_ATTEMPTS=3
DECISION_RETRY_BASE_SECONDS=1
DECISION_RETRY_JITTER_SECONDS=0.2
RUN_TIMEOUT_SECONDS=300
